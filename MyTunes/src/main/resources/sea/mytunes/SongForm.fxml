<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sea.mytunes.gui.SongFormController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="12.0">
         <children>
            <Label prefWidth="80.0" text="Title" />
            <TextField fx:id="txtTitle" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="12.0">
         <children>
            <Label prefWidth="80.0" text="Artist" />
            <TextField fx:id="txtArtist" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="12.0">
         <children>
            <Label prefWidth="80.0" text="Category" />
            <TextField fx:id="txtCategory" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="12.0">
         <children>
            <Label prefWidth="80.0" text="Time" />
            <TextField fx:id="txtTime" promptText="mm:ss" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="12.0">
         <children>
            <Label prefWidth="80.0" text="File" />
            <TextField fx:id="txtFile" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#clickChooseFile" text="Choose" />
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="8.0">
         <children>
            <Button mnemonicParsing="false" onAction="#clickCancel" text="Cancel" />
            <Button mnemonicParsing="false" text="Save" />
         </children>
      </HBox>
   </children>
</VBox>
