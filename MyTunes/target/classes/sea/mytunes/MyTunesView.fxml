<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sea.mytunes.gui.MyTunesController">
   <top>
      <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="75.0" prefWidth="200.0" spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#clickPrevious" text="⏮" />
            <Button fx:id="btnPlay" maxHeight="28.0" maxWidth="32.0" minHeight="28.0" minWidth="32.0" mnemonicParsing="false" onAction="#clickPlay" prefHeight="28.0" prefWidth="32.0" text="▶" />
            <Button mnemonicParsing="false" onAction="#clickNext" text="⏭" />
            <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label fx:id="lblNowPlayingTitle" text="No song selected" />
                  <Label fx:id="lblNowPlayingArtist" text="Unknown artist" />
               </children>
            </VBox>
            <Label fx:id="lblElapsedTime" text="0:00" />
            <Slider fx:id="sliderPlayback" prefWidth="350.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalTime" text="0:00" />
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefHeight="200.0" prefWidth="250.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Playlists" />
            <TableView fx:id="tablePlaylists" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colPlaylistName" prefWidth="110.0" text="Name" />
                <TableColumn fx:id="colPlaylistSongs" prefWidth="55.0" text="Songs" />
                  <TableColumn fx:id="colPlaylistTime" prefWidth="55.0" text="Time" />
              </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clickNewPlaylist" text="New" />
                  <Button mnemonicParsing="false" onAction="#clickEditPlaylist" text="Edit" />
                  <Button mnemonicParsing="false" onAction="#clickDeletePlaylist" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="250.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="Songs in playlist" />
            <ListView fx:id="listPlaylistSongs" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clickMoveSongUp" text="↑" />
                  <Button mnemonicParsing="false" onAction="#clickMoveSongDown" text="↓" />
                  <Button mnemonicParsing="false" onAction="#clickRemoveSongFromPlaylist" text="Delete" />
                  <Button mnemonicParsing="false" onAction="#clickAddSongToPlaylist" text="←" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <right>
      <VBox prefHeight="10.0" prefWidth="500.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Label text="All songs" />
            <HBox prefHeight="35.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <TextField fx:id="txtSearch" promptText="Search title or artist..." HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnFilter" mnemonicParsing="false" onAction="#clickFilter" text="Filter" />
               </children>
            </HBox>
            <TableView fx:id="tableSongs" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colTitle" prefWidth="150.0" text="Title" />
                <TableColumn fx:id="colArtist" prefWidth="150.0" text="Artist" />
                  <TableColumn fx:id="colCategory" prefWidth="100.0" text="Category" />
                  <TableColumn fx:id="colTime" prefWidth="70.0" text="Time" />
              </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" prefHeight="35.0" prefWidth="200.0" spacing="8.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#clickNewSong" text="New" />
                  <Button mnemonicParsing="false" onAction="#clickEditSong" text="Edit" />
                  <Button mnemonicParsing="false" onAction="#clickDeleteSong" text="Delete" />
               </children>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>
